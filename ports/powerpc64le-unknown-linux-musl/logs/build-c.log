  for f in ../../../libffi-rs/libffi-sys-rs/libffi/doc/libffi.info ../../../libffi-rs/libffi-sys-rs/libffi/doc/libffi.info-[0-9] ../../../libffi-rs/libffi-sys-rs/libffi/doc/libffi.info-[0-9][0-9] ../../../libffi-rs/libffi-sys-rs/libffi/doc/libffi.i[0-9] ../../../libffi-rs/libffi-sys-rs/libffi/doc/libffi.i[0-9][0-9]; do \
    if test -f $f; then mv $f $backupdir; restore=mv; else :; fi; \
  done; \
else :; fi && \
cd "$am__cwd"; \
if /bin/bash '/home/ubuntu/libffi-rs/libffi-sys-rs/libffi/missing' makeinfo   -I ../../../libffi-rs/libffi-sys-rs/libffi/doc \
