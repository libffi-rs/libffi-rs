  CDPATH="${ZSH_VERSION+.}:" && cd ../../../libffi-rs/libffi-sys-rs/libffi/doc; \
else \
  rc=$?; \
  CDPATH="${ZSH_VERSION+.}:" && cd ../../../libffi-rs/libffi-sys-rs/libffi/doc && \
  $restore $backupdir/* `echo "./../../../libffi-rs/libffi-sys-rs/libffi/doc/libffi.info" | sed 's|[^/]*$||'`; \
fi; \
rm -rf $backupdir; exit $rc
