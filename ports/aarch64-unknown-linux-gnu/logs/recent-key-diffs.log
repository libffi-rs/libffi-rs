+        }
+        FFI_TYPE_UINT16 => {
+            flags = AARCH64_RET_UINT16;
+        }
+        FFI_TYPE_UINT32 => {
+            flags = AARCH64_RET_UINT32;
+        }
+        FFI_TYPE_SINT8 => {
+            flags = AARCH64_RET_SINT8;
+        }
+        FFI_TYPE_SINT16 => {
+            flags = AARCH64_RET_SINT16;
+        }
+        FFI_TYPE_INT | FFI_TYPE_SINT32 => {
+            flags = AARCH64_RET_SINT32;
