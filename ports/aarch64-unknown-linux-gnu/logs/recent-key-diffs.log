+        return (&raw mut (*context).x as *mut UINT64).offset(fresh3 as isize) as *mut UINT64
+            as *mut ::core::ffi::c_void;
+    }
+    (*state).ngrn = N_X_ARG_REG as ::core::ffi::c_uint;
+    return allocate_to_stack(state, stack, size, size);
