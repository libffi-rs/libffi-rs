+
+#if defined __ELF__ && defined __linux__
+	.section .note.GNU-stack,"",%progbits
+FEATURE_1_AND_MARK(AARCH64_BTI | AARCH64_POINTER_AUTH | AARCH64_GCS)
+#endif
