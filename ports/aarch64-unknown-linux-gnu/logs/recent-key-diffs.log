+    let mut i: ::core::ffi::c_int = 0;
+    if !elements.is_null() {
+        i = 0 as ::core::ffi::c_int;
+        while !(*elements.offset(i as isize)).is_null() {
+            let mut t: ::core::ffi::c_int =
