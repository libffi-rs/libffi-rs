+unsafe extern "C" fn allocate_int_to_reg_or_stack(
+    mut context: *mut call_context,
+    mut state: *mut arg_state,
+    mut stack: *mut ::core::ffi::c_void,
+    mut size: size_t,
+) -> *mut ::core::ffi::c_void {
+    if (*state).ngrn < N_X_ARG_REG as ::core::ffi::c_uint {
+        let fresh3 = (*state).ngrn;
