+        let mut values = core::array::from_fn::<f32, 13, _>(|i| i as f32);
+        let mut args = values.each_mut().map(value_ptr);
+        let mut result = 0.0_f32;
+
+        call(
+            &mut cif,
+            many_floats as *const (),
